# 복사해서 사용하세요:  cp .env.example .env
#
# ⚠️ 이 파일은 값이 비어 있는 "템플릿"입니다. 실제 키는 .env 에만 넣으세요.
#    .env 는 .gitignore 에서 차단되어 커밋되지 않습니다.
#    이 템플릿에 실제 키를 적어 커밋하면 그대로 저장소에 남습니다.
# ------------------------------------------------------------------
# 필수
# ------------------------------------------------------------------
# https://console.anthropic.com 에서 발급 (댓글 반응 분석 / 에이전트용)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------
# 선택 — 기본값으로도 동작합니다
# ------------------------------------------------------------------
# YouTube Data API v3 키.
#   ⚠️ 대시보드(웹)는 이 값을 읽지 않습니다 — 사용자가 화면에서 자기 키를 직접 넣습니다.
#      여기에 넣은 키는 CLI 에이전트(python -m app.agent)에서만 쓰입니다.
#      공개 서버라면 비워 두세요. 채워 두면 CLI 경로가 운영자 쿼터를 소모합니다.
YOUTUBE_API_KEY=

# 키 제한 안내에 표시할 서버 고정 IP (사용자가 API 키에 IP 제한을 걸 때 필요).
#   서버가 대신 호출하므로 HTTP 리퍼러 제한은 동작하지 않습니다. 비우면 안내에서 생략됩니다.
SERVER_PUBLIC_IP=

# 세션별 수집 결과 보존 기간(일). 0 이면 자동 삭제하지 않습니다.
SESSION_DATA_TTL_DAYS=7

# ------------------------------------------------------------------
# LLM (모든 호출은 LiteLLM 을 경유합니다)
# ------------------------------------------------------------------
# LiteLLM 라우팅 접두사. 모델명에 '/' 가 없으면 "<LLM_PROVIDER>/<CLAUDE_MODEL>" 로 호출합니다.
LLM_PROVIDER=anthropic
CLAUDE_MODEL=claude-opus-5

# 한 번의 호출에서 생성할 최대 토큰 수 / 요청 타임아웃(초)
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SEC=180

# 지수 백오프 재시도 (일시적 오류·Rate Limit 전용, 폴백 체인은 없습니다).
#   대기 = LLM_RETRY_BASE_DELAY * 2^(시도-1), LLM_RETRY_MAX_DELAY 상한.
#   서버가 retry-after 헤더를 주면 그 값을 우선합니다.
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0

# 에이전트 루프 가드 — 도구 호출 왕복의 최대 횟수.
AGENT_MAX_ITERATIONS=5

# 쇼츠 판별 기준(초). 이 값을 초과하면 롱폼으로 보고 분석에서 제외합니다.
SHORTS_MAX_DURATION_SEC=60

# 수집 상한 (쿼터 보호)
MAX_VIDEOS=60
MAX_COMMENTS_PER_VIDEO=50
COMMENT_TARGET_VIDEO_COUNT=15

# 결과 저장 경로 (컨테이너 내부 경로)
DATA_DIR=/data
